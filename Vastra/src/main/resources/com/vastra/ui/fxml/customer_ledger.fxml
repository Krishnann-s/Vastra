<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.vastra.ui.controllers.CustomerLedgerController"
            stylesheets="@../css/styles.css" prefWidth="1000" prefHeight="650">

    <top>
        <VBox style="-fx-background-color: #2196F3; -fx-padding: 15;">
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Button text="← Back to Dashboard" onAction="#onBack"
                        style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4;"/>
                <Label text="Customer Ledger" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </HBox>
        </VBox>
    </top>

    <left>
        <VBox spacing="10" style="-fx-padding: 15; -fx-pref-width: 320;">
            <HBox spacing="8">
                <TextField fx:id="searchField" promptText="Search name or phone" HBox.hgrow="ALWAYS"/>
                <Button text="🔍" onAction="#onSearch"/>
            </HBox>
            <TableView fx:id="customerTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="nameColumn" text="Name" prefWidth="140"/>
                    <TableColumn fx:id="phoneColumn" text="Phone" prefWidth="90"/>
                    <TableColumn fx:id="dueColumn" text="Owes You" prefWidth="90"/>
                </columns>
            </TableView>
        </VBox>
    </left>

    <center>
        <VBox spacing="10" style="-fx-padding: 15;">
            <Label fx:id="selectedCustomerLabel" text="Select a customer" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
            <Label fx:id="totalDueLabel" text="" style="-fx-font-size: 14px; -fx-text-fill: #D32F2F;"/>

            <HBox spacing="10">
                <Button text="💵 Record Payment" onAction="#onRecordPayment" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
            </HBox>

            <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
                <Tab text="Financial Ledger">
                    <VBox spacing="10">
                        <padding><Insets top="10"/></padding>
                        <Label text="Shows credit sales and payments received (what they owe)." style="-fx-text-fill: #666; -fx-font-size: 11px;"/>
                        <TableView fx:id="ledgerTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="ledgerDateColumn" text="Date" prefWidth="140"/>
                                <TableColumn fx:id="ledgerTypeColumn" text="Type" prefWidth="90"/>
                                <TableColumn fx:id="ledgerRefColumn" text="Ref / Mode" prefWidth="120"/>
                                <TableColumn fx:id="ledgerDebitColumn" text="Sold on Credit (₹)" prefWidth="140"/>
                                <TableColumn fx:id="ledgerCreditColumn" text="Paid (₹)" prefWidth="120"/>
                                <TableColumn fx:id="ledgerBalanceColumn" text="Balance Owed (₹)" prefWidth="150"/>
                            </columns>
                        </TableView>
                    </VBox>
                </Tab>
                <Tab text="Purchase History">
                    <VBox spacing="10">
                        <padding><Insets top="10"/></padding>
                        <Label text="Every item this customer has bought, any payment method - for gift ideas and repeat-buy patterns." style="-fx-text-fill: #666; -fx-font-size: 11px;" wrapText="true"/>
                        <Label fx:id="frequentItemsLabel" style="-fx-font-weight: bold; -fx-font-size: 12px;" wrapText="true"/>
                        <TableView fx:id="purchaseHistoryTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="phDateColumn" text="Date" prefWidth="140"/>
                                <TableColumn fx:id="phBillColumn" text="Bill No" prefWidth="80"/>
                                <TableColumn fx:id="phProductColumn" text="Product" prefWidth="220"/>
                                <TableColumn fx:id="phQtyColumn" text="Qty" prefWidth="60"/>
                                <TableColumn fx:id="phPriceColumn" text="Price (₹)" prefWidth="100"/>
                                <TableColumn fx:id="phTotalColumn" text="Total (₹)" prefWidth="100"/>
                            </columns>
                            <placeholder>
                                <Label text="No purchases yet" style="-fx-text-fill: #999;"/>
                            </placeholder>
                        </TableView>
                    </VBox>
                </Tab>
            </TabPane>
        </VBox>
    </center>
</BorderPane>