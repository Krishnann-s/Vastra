<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.vastra.ui.controllers.MainController"
            stylesheets="@../css/styles.css">

    <top>
        <VBox>
            <!-- Standard Menu Bar -->
            <MenuBar>
                <Menu text="File">
                    <MenuItem fx:id="backupMenuItem" text="Backup &amp; Data" onAction="#onShowBackup"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Logout" onAction="#onLogout"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Exit" onAction="#onExit"/>
                </Menu>
                <Menu text="Sales">
                    <MenuItem fx:id="addProductMenuItem" text="Add Product (F1)" onAction="#onAddProduct"/>
                    <MenuItem fx:id="printBarcodesMenuItem" text="Print Barcodes" onAction="#onPrintBarcodes"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Complete Sale (F3)" onAction="#onCompleteSale"/>
                    <MenuItem text="Hold Sale" onAction="#onHoldSale"/>
                    <MenuItem text="Resume Held Bill" onAction="#onShowHeldBills"/>
                    <MenuItem text="Clear Cart (F4)" onAction="#onClearCart"/>
                    <MenuItem text="Share Last Bill (WhatsApp)" onAction="#onShareLastBillWhatsApp"/>
                    <MenuItem text="Customer Ledger" onAction="#onShowCustomerLedger"/>
                </Menu>
                <Menu text="Customer">
                    <MenuItem text="Add Customer (F2)" onAction="#onAddCustomer"/>
                    <MenuItem text="Redeem Points" onAction="#onRedeemPoints"/>
                    <MenuItem text="Clear Customer" onAction="#onClearCustomer"/>
                </Menu>
                <Menu text="Inventory">
                    <MenuItem text="Low Stock Alert" onAction="#onShowLowStock"/>
                    <MenuItem text="Stock Matrix (Size/Color)" onAction="#onShowStockMatrix"/>
                    <MenuItem fx:id="bulkImportMenuItem" text="Bulk Import" onAction="#onBulkImport"/>
                    <MenuItem text="Returns" onAction="#onShowReturns"/>
                </Menu>
                <Menu fx:id="suppliersMenu" text="Suppliers">
                    <MenuItem text="Suppliers &amp; Dues" onAction="#onShowSuppliers"/>
                </Menu>
                <Menu fx:id="reportsMenu" text="Reports">
                    <MenuItem text="Sales Reports" onAction="#onShowReports"/>
                </Menu>
                <Menu fx:id="toolsMenu" text="Tools">
                    <MenuItem text="Settings" onAction="#onShowSettings"/>
                </Menu>
            </MenuBar>

            <!-- Slim Icon Toolbar (quick access to the most common actions) -->
            <ToolBar styleClass="compact-toolbar">
                <Button text="🏠" onAction="#onShowDashboard" styleClass="toolbar-icon-btn">
                <tooltip><Tooltip text="Dashboard"/></tooltip>
                </Button>
                <Button fx:id="addProductToolbarBtn" text="➕" onAction="#onAddProduct" styleClass="toolbar-icon-btn">
                    <tooltip><Tooltip text="Add Product (F1)"/></tooltip>
                </Button>
                <Button fx:id="printBarcodesToolbarBtn" text="🖨️" onAction="#onPrintBarcodes" styleClass="toolbar-icon-btn">
                    <tooltip><Tooltip text="Print Barcodes"/></tooltip>
                </Button>
                <Separator orientation="VERTICAL"/>
                <Button text="👤" onAction="#onAddCustomer" styleClass="toolbar-icon-btn">
                    <tooltip><Tooltip text="Add Customer (F2)"/></tooltip>
                </Button>
                <Button text="🎁" onAction="#onRedeemPoints" styleClass="toolbar-icon-btn">
                    <tooltip><Tooltip text="Redeem Points"/></tooltip>
                </Button>
                <Separator orientation="VERTICAL"/>
                <Button fx:id="suppliersToolbarBtn" text="🚚" onAction="#onShowSuppliers" styleClass="toolbar-icon-btn">
                    <tooltip><Tooltip text="Suppliers &amp; Dues"/></tooltip>
                </Button>
                <Button fx:id="backupToolbarBtn" text="💾" onAction="#onShowBackup" styleClass="toolbar-icon-btn">
                    <tooltip><Tooltip text="Backup &amp; Data"/></tooltip>
                </Button>
                <Separator orientation="VERTICAL"/>
                <Button fx:id="reportsToolbarBtn" text="📊" onAction="#onShowReports" styleClass="toolbar-icon-btn">
                    <tooltip><Tooltip text="Reports"/></tooltip>
                </Button>
                <Button text="⚠" onAction="#onShowLowStock" styleClass="toolbar-icon-btn">
                    <tooltip><Tooltip text="Low Stock Alert"/></tooltip>
                </Button>
                <Button fx:id="settingsToolbarBtn" text="⚙" onAction="#onShowSettings" styleClass="toolbar-icon-btn">
                    <tooltip><Tooltip text="Settings"/></tooltip>
                </Button>
                <Separator orientation="VERTICAL"/>
                <Button text="🚪 Logout" onAction="#onLogout" styleClass="toolbar-icon-btn">
                    <tooltip><Tooltip text="Logout"/></tooltip>
                </Button>
            </ToolBar>

            <!-- Payment Reminder Banner - shown/hidden dynamically by MainController -->
            <Label fx:id="paymentReminderLabel" text="" maxWidth="Infinity" visible="false" managed="false"/>
            <!-- Backup Reminder Banner - shown/hidden dynamically by MainController -->
            <Label fx:id="backupReminderLabel" text="" maxWidth="Infinity" visible="false" managed="false"/>

            <!-- Low Stock Alert Bar -->
            <HBox style="-fx-background-color: #FFF3CD; -fx-padding: 5;">
                <Label fx:id="lowStockAlertLabel" text="" style="-fx-text-fill: #856404;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <!-- Cart Table - now the primary section, gets the most room -->
            <VBox spacing="5" VBox.vgrow="ALWAYS">
                <Label text="SHOPPING CART"
                       style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                <TableView fx:id="cartTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="nameColumn" text="Product" prefWidth="250"/>
                        <TableColumn fx:id="qtyColumn" text="Qty" prefWidth="80"/>
                        <TableColumn fx:id="priceColumn" text="Price" prefWidth="100"/>
                        <TableColumn fx:id="itemDiscountColumn" text="Disc (₹)" prefWidth="90"/>
                        <TableColumn fx:id="taxColumn" text="Tax" prefWidth="80"/>
                        <TableColumn fx:id="totalColumn" text="Total" prefWidth="100"/>
                        <TableColumn fx:id="actionColumn" text="Action" prefWidth="100"/>
                    </columns>
                    <placeholder>
                        <Label text="Cart is empty. Scan products to add them."
                               style="-fx-font-size: 14px; -fx-text-fill: #999;"/>
                    </placeholder>
                </TableView>
            </VBox>

            <!-- Bottom row: Actions | Customer Info | Totals -->
            <HBox spacing="20">
                <!-- Left - Actions -->
                <VBox spacing="8" prefWidth="300">
                    <Label text="ACTIONS" style="-fx-font-weight: bold;"/>
                    <HBox spacing="8">
                        <Button text="Clear (F4)"
                                onAction="#onClearCart"
                                styleClass="button-danger"
                                prefWidth="110"
                                style="-fx-font-size: 12px;"/>
                        <Button text="Hold Sale"
                                fx:id="holdSaleButton"
                                onAction="#onHoldSale"
                                styleClass="button-secondary"
                                prefWidth="140"
                                style="-fx-font-size: 12px;"/>
                    </HBox>
                    <HBox spacing="10">
                        <Label text="Manual Discount (₹):" style="-fx-padding: 5 0 0 0;"/>
                        <TextField fx:id="discountField"
                                   text="0"
                                   prefWidth="100"
                                   promptText="0.00"/>
                    </HBox>

                    <Separator/>
                    <Label text="QUICK CUSTOMER" style="-fx-font-weight: bold; -fx-font-size: 11px; -fx-text-fill: #666;"/>
                    <HBox spacing="6">
                        <TextField fx:id="quickCustomerSearchField" promptText="Search name/mobile..."
                                   HBox.hgrow="ALWAYS" onAction="#onQuickCustomerSearch"/>
                        <Button text="🔍" onAction="#onQuickCustomerSearch"/>
                    </HBox>
                    <HBox spacing="6">
                        <TextField fx:id="quickAddNameField" promptText="New: Name" prefWidth="110"/>
                        <TextField fx:id="quickAddPhoneField" promptText="Mobile" prefWidth="100"/>
                    </HBox>
                    <Button text="+ Add &amp; Use Customer" onAction="#onQuickAddCustomer"
                            style="-fx-background-color: #2196F3; -fx-text-fill: white;" maxWidth="Infinity"/>
                </VBox>

                <!-- Middle - Customer Info (moved here from the top banner) -->
                <VBox spacing="8" styleClass="customer-info-box" prefWidth="300">
                    <Label text="Customer" style="-fx-font-size: 12px; -fx-text-fill: #0D47A1;"/>
                    <Label fx:id="customerNameLabel"
                           text="Walk-in Customer"
                           style="-fx-font-weight: bold; -fx-font-size: 18px;"/>
                    <HBox spacing="20">
                        <VBox spacing="2">
                            <Label text="Loyalty Points" style="-fx-font-size: 11px; -fx-text-fill: #0D47A1;"/>
                            <Label fx:id="customerPointsLabel"
                                   text="0 points"
                                   style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #4CAF50;"/>
                        </VBox>
                        <VBox spacing="2">
                            <Label text="Cashier" style="-fx-font-size: 11px; -fx-text-fill: #0D47A1;"/>
                            <TextField fx:id="cashierNameField" text="Admin" prefWidth="120" editable="false"
                                       style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-background-color: #eee;"/>
                        </VBox>
                    </HBox>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Label text="1 point = ₹1 discount · Earn 1 point per ₹100 spent"
                           wrapText="true" style="-fx-font-size: 10px; -fx-text-fill: #666;"/>
                </VBox>

                <!-- Right - Totals -->
                <VBox spacing="8" styleClass="totals-box" HBox.hgrow="ALWAYS" minWidth="300">
                    <HBox spacing="10">
                        <Label text="Subtotal:" styleClass="subtotal-label" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="subtotalLabel"
                               text="₹0.00"
                               styleClass="subtotal-label"
                               style="-fx-font-weight: bold;"/>
                    </HBox>
                    <Separator/>
                    <HBox spacing="10">
                        <Label text="Tax (included):" styleClass="tax-label" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="taxLabel"
                               text="₹0.00"
                               styleClass="tax-label"/>
                    </HBox>
                    <HBox spacing="10">
                        <Label text="Discount:" styleClass="discount-label" HBox.hgrow="ALWAYS"/>
                        <Label fx:id="discountTotalLabel" text="- ₹0.00" styleClass="discount-label"/>
                    </HBox>
                    <Separator style="-fx-background-color: #4CAF50;"/>
                    <HBox spacing="10">
                        <Label text="TOTAL:"
                               styleClass="total-label"
                               HBox.hgrow="ALWAYS"/>
                        <Label fx:id="totalLabel"
                               text="₹0.00"
                               styleClass="total-label"/>
                    </HBox>
                    <Separator/>
                    <Button text="💳 COMPLETE SALE (F3)"
                            onAction="#onCompleteSale"
                            styleClass="button-primary"
                            maxWidth="Infinity"
                            prefHeight="50"/>
                </VBox>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox style="-fx-background-color: #f5f5f5; -fx-padding: 10; -fx-border-color: #ddd; -fx-border-width: 1 0 0 0;">
            <Label text="Vastra Billing System v1.0 | " style="-fx-text-fill: #666;"/>
            <Label text="F1: Add Product | F2: Add Customer | F3: Complete Sale | F4: Clear Cart | F5: Hold Sale"
                   style="-fx-text-fill: #999; -fx-font-size: 11px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="🔍 Scan product barcodes - items appear automatically!"
                   style="-fx-text-fill: #4CAF50; -fx-font-weight: bold;"/>
        </HBox>
    </bottom>
</BorderPane>
