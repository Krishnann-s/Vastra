<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.vastra.ui.controllers.ProductListController"
            prefWidth="1150" prefHeight="650">

    <top>
        <VBox style="-fx-background-color: #2196F3; -fx-padding: 15;" spacing="10">
            <Label text="Full Stock" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="e.g. half hand jersey tshirt size 32"
                           HBox.hgrow="ALWAYS" onAction="#onSearch"/>
                <Button text="Search" onAction="#onSearch"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TableView fx:id="table">
            <columns>
                <TableColumn fx:id="codeColumn" text="Code" prefWidth="110"/>
                <TableColumn fx:id="nameColumn" text="Name" prefWidth="220"/>
                <TableColumn fx:id="brandColumn" text="Brand" prefWidth="100"/>
                <TableColumn fx:id="categoryColumn" text="Category" prefWidth="150"/>
                <TableColumn fx:id="sizeColumn" text="Size" prefWidth="60"/>
                <TableColumn fx:id="colorColumn" text="Color" prefWidth="80"/>
                <TableColumn fx:id="mrpColumn" text="MRP" prefWidth="80"/>
                <TableColumn fx:id="sellPriceColumn" text="Sell Price" prefWidth="80"/>
                <TableColumn fx:id="purchasePriceColumn" text="Purchase Price" prefWidth="100"/>
                <TableColumn fx:id="stockColumn" text="Stock" prefWidth="60"/>
                <TableColumn fx:id="openingStockColumn" text="Opening Stock" prefWidth="100"/>
                <TableColumn fx:id="actionsColumn" text="" prefWidth="140"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10 15; -fx-background-color: #f5f5f5; -fx-border-color: #ddd; -fx-border-width: 1 0 0 0;">
            <Label fx:id="statusLabel"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Close" onAction="#onClose"/>
        </HBox>
    </bottom>
</BorderPane>
