<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.vastra.ui.controllers.ReportsFormController"
            prefWidth="1150" prefHeight="720">

    <top>
        <VBox style="-fx-background-color: #2196F3; -fx-padding: 15;">
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Button text="← Back to Dashboard" onAction="#onBack"
                        style="-fx-background-color: rgba(255,255,255,0.2); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4;"/>
                <Label text="Reports" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">

            <!-- ============ DAILY SALES ============ -->
            <Tab text="Daily Sales">
                <VBox spacing="10">
                    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="From:"/>
                        <DatePicker fx:id="dailyStartDatePicker"/>
                        <Label text="To:"/>
                        <DatePicker fx:id="dailyEndDatePicker"/>
                        <Button text="🔍 Load" onAction="#onLoadDailySales"/>
                        <Button text="📥 Export to Excel" onAction="#onExportDailySales"
                                style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
                    </HBox>

                    <TableView fx:id="dailySalesTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="dsDateColumn" text="Date" prefWidth="150"/>
                            <TableColumn fx:id="dsCountColumn" text="# Sales" prefWidth="100"/>
                            <TableColumn fx:id="dsRevenueColumn" text="Revenue (₹)" prefWidth="150"/>
                            <TableColumn fx:id="dsTaxColumn" text="Tax (₹)" prefWidth="150"/>
                            <TableColumn fx:id="dsDiscountColumn" text="Discount Given (₹)" prefWidth="170"/>
                        </columns>
                        <placeholder>
                            <Label text="No sales in this date range" style="-fx-text-fill: #999;"/>
                        </placeholder>
                    </TableView>

                    <Label fx:id="dailyTotalsLabel" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
                </VBox>
            </Tab>

            <!-- ============ STOCK VALUATION ============ -->
            <Tab text="Stock Valuation">
                <VBox spacing="10">
                    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="🔄 Refresh" onAction="#onLoadStockValuation"/>
                        <Button text="📥 Export to Excel" onAction="#onExportStockValuation"
                                style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
                    </HBox>

                    <TableView fx:id="stockTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="svProductColumn" text="Product" prefWidth="220"/>
                            <TableColumn fx:id="svCategoryColumn" text="Category" prefWidth="120"/>
                            <TableColumn fx:id="svStockColumn" text="Stock" prefWidth="80"/>
                            <TableColumn fx:id="svCostPriceColumn" text="Cost Price (₹)" prefWidth="120"/>
                            <TableColumn fx:id="svSellPriceColumn" text="Sell Price (₹)" prefWidth="120"/>
                            <TableColumn fx:id="svCostValueColumn" text="Stock at Cost (₹)" prefWidth="140"/>
                            <TableColumn fx:id="svSellValueColumn" text="Stock at Selling Price (₹)" prefWidth="180"/>
                        </columns>
                        <placeholder>
                            <Label text="No products yet" style="-fx-text-fill: #999;"/>
                        </placeholder>
                    </TableView>

                    <Label fx:id="stockTotalsLabel" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
                </VBox>
            </Tab>

            <!-- ============ EXPENSES ============ -->
            <Tab text="Expense Log">
                <BorderPane>
                    <left>
                        <VBox spacing="8" prefWidth="280">
                            <padding><Insets top="15" right="10" bottom="15" left="15"/></padding>
                            <Label text="Record an Expense" style="-fx-font-weight: bold;"/>
                            <ComboBox fx:id="expenseCategoryCombo" promptText="Category" maxWidth="Infinity"/>
                            <TextField fx:id="expenseDescField" promptText="Description (e.g. Shop rent - July)"/>
                            <TextField fx:id="expenseAmountField" promptText="Amount (₹)"/>
                            <DatePicker fx:id="expenseDatePicker" maxWidth="Infinity"/>
                            <ComboBox fx:id="expensePaymentModeCombo" promptText="Paid via" maxWidth="Infinity"/>
                            <Button text="+ Add Expense" onAction="#onAddExpense"
                                    style="-fx-background-color: #4CAF50; -fx-text-fill: white;" maxWidth="Infinity"/>
                        </VBox>
                    </left>
                    <center>
                        <VBox spacing="10">
                            <padding><Insets top="15" right="15" bottom="15" left="10"/></padding>
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="From:"/>
                                <DatePicker fx:id="expenseStartDatePicker"/>
                                <Label text="To:"/>
                                <DatePicker fx:id="expenseEndDatePicker"/>
                                <Button text="🔍 Load" onAction="#onLoadExpenses"/>
                                <Button text="📥 Export to Excel" onAction="#onExportExpenses"
                                        style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
                            </HBox>
                            <TableView fx:id="expensesTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="exDateColumn" text="Date" prefWidth="110"/>
                                    <TableColumn fx:id="exCategoryColumn" text="Category" prefWidth="130"/>
                                    <TableColumn fx:id="exDescColumn" text="Description" prefWidth="240"/>
                                    <TableColumn fx:id="exAmountColumn" text="Amount (₹)" prefWidth="110"/>
                                    <TableColumn fx:id="exModeColumn" text="Paid Via" prefWidth="100"/>
                                    <TableColumn fx:id="exActionColumn" text="Action" prefWidth="90"/>
                                </columns>
                                <placeholder>
                                    <Label text="No expenses recorded in this range" style="-fx-text-fill: #999;"/>
                                </placeholder>
                            </TableView>
                            <Label fx:id="expenseTotalLabel" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
                        </VBox>
                    </center>
                </BorderPane>
            </Tab>

        </TabPane>
    </center>
</BorderPane>
